{
  "name": "calculate_profit",
  "domain": "profitability",
  "version": "0.1.0",
  "description": "Calculate net profit and related profitability metrics from explicit commerce cost inputs.",
  "input_schema": {
    "type": "object",
    "required": ["selling_price", "product_cost"],
    "properties": {
      "selling_price": { "type": "number" },
      "product_cost": { "type": "number" },
      "marketplace_fee": { "type": "number", "default": 0 },
      "payment_fee": { "type": "number", "default": 0 },
      "shipping_cost": { "type": "number", "default": 0 },
      "return_cost": { "type": "number", "default": 0 },
      "ad_cost": { "type": "number", "default": 0 },
      "other_costs": { "type": "number", "default": 0 },
      "quantity": { "type": "integer", "minimum": 1, "default": 1 },
      "currency": { "type": "string", "default": "KRW" }
    }
  },
  "output_schema": {
    "type": "object",
    "required": ["gross_revenue", "total_costs", "net_profit", "margin_rate", "roi", "break_even_unit_price"],
    "properties": {
      "gross_revenue": { "type": "number" },
      "total_costs": { "type": "number" },
      "net_profit": { "type": "number" },
      "margin_rate": { "type": "number" },
      "roi": { "type": "number" },
      "break_even_unit_price": { "type": "number" },
      "cost_breakdown": { "type": "object" }
    }
  },
  "agent_compatibility": ["LangGraph", "MCP", "n8n", "OpenAI Codex", "Claude Code"]
}
