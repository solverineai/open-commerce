{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencommerce.dev/datasets/economics-dataset.schema.json",
  "title": "Open Commerce Economics Dataset",
  "description": "Shared schema for marketplace, logistics, payment, and advertising economics datasets.",
  "type": "object",
  "required": [
    "schema_version",
    "dataset_type",
    "provider",
    "coverage",
    "fee_structures",
    "settlement_rules",
    "shipping_costs",
    "return_costs",
    "metadata",
    "source_references",
    "version_history"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "dataset_type": {
      "type": "string",
      "enum": ["marketplace", "logistics", "payments", "advertising"]
    },
    "provider": {
      "type": "object",
      "required": ["id", "name", "category"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "country_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "required": ["markets", "currency", "status"],
      "additionalProperties": false,
      "properties": {
        "markets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        },
        "status": {
          "type": "string",
          "enum": ["starter", "draft", "reviewed", "stable", "deprecated"]
        }
      }
    },
    "fee_structures": {
      "$ref": "#/$defs/rules"
    },
    "settlement_rules": {
      "$ref": "#/$defs/rules"
    },
    "shipping_costs": {
      "$ref": "#/$defs/rules"
    },
    "return_costs": {
      "$ref": "#/$defs/rules"
    },
    "metadata": {
      "type": "object",
      "required": ["version", "status", "license", "last_reviewed", "maintainers"],
      "additionalProperties": true,
      "properties": {
        "version": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["starter", "draft", "reviewed", "stable", "deprecated"]
        },
        "license": {
          "type": "string"
        },
        "last_reviewed": {
          "type": "string"
        },
        "maintainers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "source_references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "publisher", "reliability"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "url": {
            "type": ["string", "null"]
          },
          "accessed_at": {
            "type": ["string", "null"]
          },
          "reliability": {
            "type": "string",
            "enum": ["official", "partner", "community", "inferred", "unknown"]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "version_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["version", "released_at", "changes"],
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "string"
          },
          "released_at": {
            "type": "string"
          },
          "changes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "status", "basis", "source_ref_ids"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["starter", "draft", "reviewed", "stable", "deprecated"]
          },
          "basis": {
            "type": "string"
          },
          "value": {
            "type": ["object", "number", "string", "null"],
            "additionalProperties": true
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_ref_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
